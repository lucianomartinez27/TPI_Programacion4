# Database (PostgreSQL recomendado; para desarrollo local se acepta SQLite)
# DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
DATABASE_URL=sqlite:///./food_store.db

# JWT (obligatoria, mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Cookies (true en producción sobre HTTPS)
SECURE_COOKIES=false
